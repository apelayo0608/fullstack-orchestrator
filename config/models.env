# Model routing for fullstack-orchestrator.
# Edit these values to swap models; every script sources this file.
# Variables already exported in the shell take precedence.

# Orchestrators (informational: the host session itself must be launched with these)
: "${ORCH_ORCHESTRATOR_MODEL_CLAUDE:=claude-opus-5-5}"
: "${ORCH_ORCHESTRATOR_EFFORT_CLAUDE:=high}"
: "${ORCH_ORCHESTRATOR_MODEL_CODEX:=gpt-6.1-sol}"
: "${ORCH_ORCHESTRATOR_EFFORT_CODEX:=high}"

# Full-stack developer, both hosts (OpenCode, provider/model#variant)
: "${ORCH_DEV_MODEL:=opencode-go/deepseek-v4.1-flash#max}"

# Reviewer when Claude orchestrates (runs through `codex exec`, read-only sandbox)
: "${ORCH_REVIEW_MODEL_ON_CLAUDE:=gpt-6.1-sol}"
: "${ORCH_REVIEW_EFFORT_ON_CLAUDE:=medium}"

# Reviewer when Codex orchestrates (runs through `claude -p`, edit tools denied)
: "${ORCH_REVIEW_MODEL_ON_CODEX:=claude-opus-5-5}"
: "${ORCH_REVIEW_EFFORT_ON_CODEX:=medium}"

# Fix rounds per task before the orchestrator must escalate to the user
: "${ORCH_MAX_FIX_ROUNDS:=3}"
