# Model routing for fullstack-orchestrator.
# Edit these values to swap providers, models or thinking levels; every script sources this file.
# Variables already exported in the shell take precedence. Prefer `fullstack-orchestrator models`,
# which saves per-user choices outside the repo.
#
# Every role has three knobs: provider (runner), model, thinking level (effort).
# Runners: opencode (any OpenCode provider/model), claude (claude -p), codex (codex exec).

# --- Orchestrator: the host session itself (informational: launch the host with these) ---
: "${ORCH_ORCHESTRATOR_MODEL_CLAUDE:=claude-opus-5-5}"
: "${ORCH_ORCHESTRATOR_EFFORT_CLAUDE:=medium}"
: "${ORCH_ORCHESTRATOR_MODEL_CODEX:=gpt-6.1-sol}"
: "${ORCH_ORCHESTRATOR_EFFORT_CODEX:=medium}"

# --- Developer ---
# Runner: opencode | claude | codex. claude resumes its session for fix rounds;
# codex starts a fresh session each run, so it always receives the full contract.
: "${ORCH_DEV_RUNNER:=opencode}"
# Model id. For opencode: provider/model (a trailing #variant pins the thinking level
# and beats the effort settings below).
: "${ORCH_DEV_MODEL:=opencode/gpt-5.6-luna}"
# Thinking level. Tasks with risk: high use the second value, everything else the first.
: "${ORCH_DEV_EFFORT:=high}"
: "${ORCH_DEV_EFFORT_HIGH_RISK:=max}"

# --- Reviewer (read-only) ---
# Runner: auto = the other vendor of the host (codex when Claude orchestrates, claude when
# Codex does). Or force opencode | claude | codex.
: "${ORCH_REVIEW_RUNNER:=auto}"
# Empty model/effort: use the per-host defaults below. Set them to override for any runner.
: "${ORCH_REVIEW_MODEL:=}"
: "${ORCH_REVIEW_EFFORT:=}"          # round 1 and full reviews of risk: high
: "${ORCH_REVIEW_EFFORT_LOW:=}"      # tasks with risk: low
: "${ORCH_REVIEW_EFFORT_DELTA:=low}" # later rounds: only checks the fixes (empty: same as round 1)

# Per-host reviewer defaults, used while ORCH_REVIEW_RUNNER=auto and the values above are empty.
: "${ORCH_REVIEW_MODEL_ON_CLAUDE:=gpt-6.1-sol}"   # runs through `codex exec`, read-only sandbox
: "${ORCH_REVIEW_EFFORT_ON_CLAUDE:=medium}"
: "${ORCH_REVIEW_EFFORT_LOW_ON_CLAUDE:=low}"
: "${ORCH_REVIEW_MODEL_ON_CODEX:=claude-opus-5-5}" # runs through `claude -p`, edit tools denied
: "${ORCH_REVIEW_EFFORT_ON_CODEX:=medium}"
: "${ORCH_REVIEW_EFFORT_LOW_ON_CODEX:=low}"

# risk: low tasks whose diff has fewer changed lines than this skip model review
# (checks only, like risk: none). 0 disables.
: "${ORCH_SKIP_REVIEW_LINES:=100}"

# Review fix rounds per task before the orchestrator must escalate to the user
: "${ORCH_MAX_FIX_ROUNDS:=1}"

# Automated check failures sent straight back to the developer before giving up
: "${ORCH_MAX_CHECK_FIXES:=2}"

# Test command for check.sh. Empty: use the "Test commands:" line of plan.md.
: "${ORCH_CHECK_CMD:=}"

# Task worktrees (task-worktree.sh). Empty root: <repo parent>/.<repo name>-orch.
# Empty setup: install dependencies according to the lockfile.
: "${ORCH_WORKTREE_ROOT:=}"
: "${ORCH_WORKTREE_SETUP:=}"
